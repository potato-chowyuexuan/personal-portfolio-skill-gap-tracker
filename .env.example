# --- Backend (server.ts / Render) ---------------------------------------

# DATABASE_URL: Postgres connection string. Get this from your Neon
# project's dashboard (Connection Details) — it looks like:
# postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ANTHROPIC_API_KEY: Optional. Powers the AI project-summary and
# notes-classification features (Claude). Without it, those features fall
# back to a deterministic rule-based generator — the app still works fully.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# FRONTEND_URL: The origin(s) allowed to call this API (CORS). Comma-separate
# multiple origins, e.g. your production Vercel domain plus a preview URL.
# Leave BLANK for local dev (defaults to allowing all origins) — only set
# this once you've deployed, to your actual Vercel URL:
# FRONTEND_URL="https://your-app.vercel.app"
FRONTEND_URL=

# PORT: Optional locally (defaults to 3000). Render sets this automatically
# in production — do not hardcode it there.
PORT=3000

# --- Frontend (Vite / Vercel) --------------------------------------------

# VITE_API_BASE_URL: The deployed backend's base URL (no trailing slash, no
# /api suffix — that's added automatically). Leave BLANK for local dev,
# where the frontend and backend share an origin via Vite's dev middleware —
# only set this once you've deployed the backend, e.g.:
# VITE_API_BASE_URL="https://your-backend.onrender.com"
VITE_API_BASE_URL=
